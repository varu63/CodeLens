# ProofLoop frontend environment variables
# Copy to .env and adjust for your setup.

# Base URL of the ProofLoop API (all routes below are relative to this base).
VITE_API_URL=http://localhost:5000/api/v1

# Use the built-in mock adapter with realistic sample data.
# Set to true to run the entire UI without a backend.
VITE_USE_MOCKS=false
