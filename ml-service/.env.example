# ProofLoop ml-service environment
# Copy to .env and adjust. The backend calls this service when ML_ENABLED=true.

# Models (fixed choices, do not swap)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CODE_EMBED_MODEL=microsoft/unixcoder-base
LLM_MODEL=qwen2.5-coder:1.5b
OLLAMA_URL=http://localhost:11434

# Saved artifacts (offline training writes here; runtime only loads)
RISK_MODEL_PATH=models/bug_risk.joblib
VULN_MODEL_PATH=models/vuln_classifier.joblib

# Every pipeline stage has a timeout; a slow LLM must never block a run
STAGE_TIMEOUT_SECONDS=60

# Snapshot limits
SNAPSHOT_MAX_FILES=5000
SNAPSHOT_MAX_FILE_MB=1
SNAPSHOT_MAX_SECONDS=60

# Shared with the backend when ML_SERVICE_KEY is set there
REDIS_URL=redis://localhost:6379
ML_SERVICE_KEY=
