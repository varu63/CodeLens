# ProofLoop backend environment variables
# Copy to .env and adjust for your setup.

# HTTP
PORT=5000
NODE_ENV=development

# Postgres (docker-compose provides this by default)
DATABASE_URL=postgres://proofloop:proofloop@localhost:5432/proofloop

# Redis (BullMQ queue)
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret

# Google OAuth 2.0 (Authorization Code flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Where the browser app lives (OAuth redirect back + CORS origin)
FRONTEND_URL=http://localhost:5173

# S3 / MinIO artifact storage
S3_ENDPOINT=http://localhost:9090
S3_BUCKET=proofloop
S3_ACCESS_KEY=proofloop
S3_SECRET_KEY=proofloop-secret

# ML service (Python FastAPI, not built yet). When false, rule-based stubs run.
ML_ENABLED=false
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_KEY=

# Docker sandbox limits for verification runs
SANDBOX_CPU_LIMIT=1.5
SANDBOX_MEMORY_MB=1024
SANDBOX_TIMEOUT_SEC=300
